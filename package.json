{
  "name": "lingdian-chujuan",
  "version": "0.1.24",
  "private": true,
  "description": "ZeroPoint Paper (零点出卷) - AI exam paper generator for junior-high math",
  "main": "./out/main/index.js",
  "author": "辰辰",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/anyncfunction/ZeroPoint-Paper.git"
  },
  "homepage": "https://github.com/anyncfunction/ZeroPoint-Paper#readme",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "make:icon": "node scripts/make-icon.cjs",
    "package:win": "npm run make:icon && npm run build && node scripts/package-win.mjs"
  },
  "dependencies": {
    "docx": "^9.5.1",
    "katex": "^0.16.22",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "jsdom": "^25.0.1",
    "png-to-ico": "^3.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "cn.lingdian.chujuan",
    "productName": "零点出卷",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "resources/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "零点出卷-${version}-安装版.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "零点出卷",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052"
    }
  }
}
